// duplicate_declarations.gopi
// Expected: 2 diagnostics (both SEMANTIC):
//   1. "function 'add' is already declared" (Pass 1, top-level).
//   2. "variable 'x' is already declared in this scope" (Pass 2, same scope —
//      not shadowing, since both declarations are at the same nesting level).

num add(num a, num b) {
    give a + b;
}

num add(num a, num b) {
    give a - b;
}

none main() {
    num x = 1;
    num x = 2;
    show(x);
}
