// return_checking.gopi
// Expected: 4 diagnostics:
//   1. [TYPE] "cannot return a value from a function declared 'VOID'" (noop).
//   2. [TYPE] "missing return value in function declared to return 'INT'"
//      (missingValue's bare `return;`).
//   3. [TYPE] "cannot return 'BOOL' from a function declared to return 'INT'"
//      (wrongType).
//   4. [TYPE] "function 'noReturnOnAllPaths' does not return a value on all
//      paths" — reachability, not a per-statement return check.
// correct() produces nothing.

void noop() {
    return 5;
}

int missingValue() {
    return;
}

int wrongType() {
    return true;
}

int noReturnOnAllPaths(bool flag) {
    if (flag) {
        return 1;
    }
}

int correct() {
    return 1;
}

void main() {
}
