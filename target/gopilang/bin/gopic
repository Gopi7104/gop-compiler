#!/usr/bin/env bash
# GopiLang CLI launcher. Locates the bundled gopilang.jar relative to this
# script's own real location (resolving symlinks first, so this keeps working
# whether it's run directly, via a symlink from /usr/local/bin, or after the
# whole installation folder has been moved) and forwards every argument.
set -euo pipefail

resolve_bin_dir() {
    local source="${BASH_SOURCE[0]}"
    while [ -h "$source" ]; do
        local dir
        dir="$(cd -P "$(dirname "$source")" && pwd)"
        source="$(readlink "$source")"
        [[ "$source" != /* ]] && source="$dir/$source"
    done
    cd -P "$(dirname "$source")" && pwd
}

BIN_DIR="$(resolve_bin_dir)"
JAR="$BIN_DIR/../lib/gopilang.jar"

exec java -jar "$JAR" "$@"
