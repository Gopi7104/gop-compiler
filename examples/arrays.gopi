// arrays.gopi - array creation, indexing, assignment, and length

num sum(num[] values) {
    num total = 0;
    num i = 0;
    loop (i < values.len()) {
        total = total + values[i];
        i = i + 1;
    }
    give total;
}

none main() {
    num[] numbers = new num[5];
    num i = 0;
    loop (i < numbers.len()) {
        numbers[i] = i * 10;
        i = i + 1;
    }

    i = 0;
    loop (i < numbers.len()) {
        show(numbers[i]);
        i = i + 1;
    }

    show(sum(numbers));

    text[] names = new text[3];
    names[0] = "gopi";
    names[1] = "lang";
    names[2] = "v2";
    show(names[0] + names[1] + names[2]);

    flag[] flags = new flag[2];
    flags[0] = yes;
    flags[1] = no;
    show(flags[0]);
    show(flags[1]);
    show(flags.len());
}
