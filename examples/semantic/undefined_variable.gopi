// undefined_variable.gopi
// Expected: 1 diagnostic (SEMANTIC) — "undefined variable 'y'". y is never
// declared anywhere. Note this must NOT also produce a "might not have been
// assigned" diagnostic — an unresolved reference is poisoned (no symbol at
// all), and the assignment check only runs once resolution has already
// succeeded, to avoid exactly this kind of cascade.

none main() {
    show(y);
}
