// function_calls.gopi
// Expected: 3 diagnostics:
//   1. [SEMANTIC] "undefined function 'missing'" — no such function exists.
//   2. [TYPE] "function 'add' expects 2 argument(s), found 1" — wrong count.
//   3. [TYPE] "argument 2 of 'add': expected 'INT', found 'BOOL'" — wrong type.
// The correctly-formed call (add(1, 2)) produces nothing.

int add(int a, int b) {
    return a + b;
}

void main() {
    print(add(1, 2));
    missing();
    add(1);
    add(1, true);
}
